# Copy to .env (git-ignored) and fill in locally. NEVER commit .env. NEVER paste keys into chat.
# Use TEST-ONLY accounts that hold nothing but Sepolia test ETH.

# Sepolia RPC endpoint (Alchemy / Infura / any provider)
SEPOLIA_RPC_URL=https://sepolia.example-rpc.invalid/your-key-here

# Owner / deployer account (test-only). 64 hex chars, with or without 0x.
DEPLOYER_PRIVATE_KEY=

# Second, throwaway account used as the AI AGENT in the demo (needs a little Sepolia ETH for gas).
AGENT_PRIVATE_KEY=

# Optional: for `npx hardhat verify --network sepolia ...`
ETHERSCAN_API_KEY=

# Optional: attach demo to already-deployed contracts instead of deploying fresh ones
TOKEN_ADDRESS=
VAULT_ADDRESS=

# Optional: payee address used by the demo on Sepolia (defaults to a fresh random address)
PAYEE_ADDRESS=
